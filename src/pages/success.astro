---
import Layout from '../layouts/Layout.astro';
import { DOWNLOAD_URL, licenseApiBase } from '../data/pricing';

const apiBase = licenseApiBase();
---

<Layout
  title="Payment success — CareFlow License"
  description="Your CareFlow lifetime license key after Paddle checkout."
  canonicalPath="/success"
  minimal
>
  <section class="wrap">
    <div class="card" id="loading">
      <div class="spinner" aria-hidden="true"></div>
      <p class="eyebrow">License server</p>
      <h1>Generating your key</h1>
      <p class="lead" id="status">Confirming payment and creating your lifetime license…</p>
      <div class="bar" aria-hidden="true">
        <span id="bar-fill"></span>
      </div>
      <p class="hint" id="progress">Talking to the license server…</p>
    </div>

    <div class="card" id="result" hidden>
      <p class="eyebrow" id="result-eyebrow">Lifetime license</p>
      <h1 id="result-title">You&apos;re all set</h1>
      <p class="lead" id="result-lead">Your lifetime license is ready. Copy the key, then download and activate CareFlow.</p>

      <div class="keybox" id="keybox">
        <span>Your license key</span>
        <div class="keyrow">
          <code id="key" tabindex="0" title="Click to copy"></code>
          <button type="button" id="copy">Copy key</button>
        </div>
      </div>
      <p class="hint" id="renew-hint" hidden></p>

      <div class="actions">
        <a class="primary" href={DOWNLOAD_URL}>Download CareFlow Setup.exe</a>
        <a class="ghost" href="/renew">Renew hosted services</a>
        <a class="ghost" href="/#packages">Back to packages</a>
      </div>
      <p class="hint" id="keep-hint">Keep this key safe — it is not emailed.</p>
    </div>

    <div class="card error" id="not-found" hidden>
      <p class="eyebrow danger">Not found</p>
      <h1>Could not verify payment</h1>
      <p class="lead" id="not-found-msg">
        This page only opens after a completed Paddle checkout with a valid transaction id.
      </p>
      <div class="actions">
        <a class="ghost" href="/renew">Renew hosted services</a>
        <a class="ghost" href="/#packages">Back to packages</a>
      </div>
    </div>
  </section>

  <script define:vars={{ apiBase }}>
    const params = new URLSearchParams(window.location.search);
    const rawTxn = String(params.get('_ptxn') || '').trim();
    const txnOk = /^txn_[a-z0-9]+$/i.test(rawTxn);

    const loading = document.getElementById('loading');
    const result = document.getElementById('result');
    const notFound = document.getElementById('not-found');
    const notFoundMsg = document.getElementById('not-found-msg');
    const status = document.getElementById('status');
    const progress = document.getElementById('progress');
    const barFill = document.getElementById('bar-fill');
    const keyEl = document.getElementById('key');
    const copy = document.getElementById('copy');

    function hideLoading() {
      if (loading) loading.hidden = true;
    }

    function setProgress(attempt, max) {
      if (barFill) barFill.style.width = Math.min(96, Math.round((attempt / max) * 100)) + '%';
      if (progress) {
        progress.textContent = 'License server request ' + attempt + ' of ' + max + '…';
      }
    }

    function showNotFound(message) {
      hideLoading();
      if (result) result.hidden = true;
      if (notFound) notFound.hidden = false;
      if (notFoundMsg && message) notFoundMsg.textContent = message;
      document.title = 'Transaction ID not found — CareFlow';
    }

    const resultEyebrow = document.getElementById('result-eyebrow');
    const resultTitle = document.getElementById('result-title');
    const resultLead = document.getElementById('result-lead');
    const renewHint = document.getElementById('renew-hint');
    const keepHint = document.getElementById('keep-hint');

    function fmtDate(value) {
      if (!value) return null;
      const d = new Date(value);
      if (Number.isNaN(d.getTime())) return null;
      return d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
    }

    function applyRenewCopy(data) {
      const isRenew = data?.kind === 'renew' || params.get('renew') === '1';
      if (!isRenew) return;
      if (resultEyebrow) resultEyebrow.textContent = 'Hosted renewal';
      if (resultTitle) resultTitle.textContent = 'Services are back on';
      if (resultLead) {
        resultLead.textContent =
          'Payment confirmed. Restart CareFlow (or sign in again) so WhatsApp, AI and online DB pick up the new dates.';
      }
      const bits = [];
      if (data?.onlineDatabaseExpiresAt) bits.push('Online DB until ' + fmtDate(data.onlineDatabaseExpiresAt));
      if (data?.whatsappExpiresAt) bits.push('WhatsApp until ' + fmtDate(data.whatsappExpiresAt));
      if (data?.aiExpiresAt) bits.push('AI until ' + fmtDate(data.aiExpiresAt));
      if (renewHint) {
        renewHint.hidden = bits.length === 0;
        renewHint.textContent = bits.join(' · ');
      }
      if (keepHint) keepHint.textContent = 'Your lifetime Windows license key did not change.';
    }

    function showKey(key, data) {
      if (!key) return;
      hideLoading();
      if (notFound) notFound.hidden = true;
      if (result) result.hidden = false;
      if (barFill) barFill.style.width = '100%';
      keyEl.textContent = key;
      applyRenewCopy(data || { kind: params.get('renew') === '1' ? 'renew' : 'purchase' });
      try {
        sessionStorage.removeItem('careflow_ptxn');
      } catch {
        /* ignore */
      }
    }

    function copyKey() {
      const value = keyEl.textContent || '';
      if (!value) return;
      navigator.clipboard.writeText(value).then(
        () => {
          copy.textContent = 'Copied';
          setTimeout(() => {
            copy.textContent = 'Copy key';
          }, 1800);
        },
        () => {
          const range = document.createRange();
          range.selectNodeContents(keyEl);
          const sel = window.getSelection();
          sel?.removeAllRanges();
          sel?.addRange(range);
          copy.textContent = 'Select and copy';
        },
      );
    }

    copy?.addEventListener('click', copyKey);
    keyEl?.addEventListener('click', copyKey);

    async function loadLicense(id) {
      const maxAttempts = 10;
      for (let attempt = 1; attempt <= maxAttempts; attempt++) {
        setProgress(attempt, maxAttempts);
        if (status) {
          status.textContent =
            attempt === 1
              ? 'Confirming payment and creating your lifetime license…'
              : 'Still generating your license key. This can take a few seconds…';
        }
        try {
          const res = await fetch(apiBase + '/api/billing/session/' + encodeURIComponent(id));
          if (res.status === 404) {
            showNotFound('Transaction ID not found. No matching Paddle payment was found for this id.');
            return false;
          }
          const json = await res.json().catch(() => null);
          if (json?.data?.paid && json.data.licenseKey) {
            showKey(json.data.licenseKey, json.data);
            return true;
          }
        } catch {
          if (attempt === maxAttempts) {
            showNotFound('Could not reach the license server. Please try again from your Paddle receipt link.');
            return false;
          }
        }
        await new Promise((r) => setTimeout(r, 2000));
      }
      showNotFound('Transaction ID not found or payment was not completed.');
      return false;
    }

    (async () => {
      const mockKey = String(params.get('key') || '')
        .trim()
        .toUpperCase();
      if (params.get('mock') === '1' && mockKey) {
        showKey(mockKey, { kind: params.get('renew') === '1' ? 'renew' : 'purchase' });
        return;
      }
      if (!rawTxn) {
        showNotFound(
          'No transaction id in the URL. Open this page only after checkout, e.g. /success?_ptxn=txn_…',
        );
        return;
      }
      if (!txnOk) {
        showNotFound('Invalid transaction id. It must look like txn_01…');
        return;
      }
      try {
        sessionStorage.setItem('careflow_ptxn', rawTxn);
      } catch {
        /* ignore */
      }
      await loadLicense(rawTxn);
    })();
  </script>
</Layout>

<style>
  .wrap {
    min-height: 100dvh;
    display: grid;
    place-items: center;
    padding: 88px 20px 28px;
    overflow: auto;
  }

  .card {
    width: min(480px, 100%);
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 24px;
    padding: 28px 24px;
    box-shadow: 0 20px 50px rgba(15, 20, 16, 0.08);
    text-align: center;
  }

  .spinner {
    width: 44px;
    height: 44px;
    margin: 0 auto 16px;
    border: 3px solid var(--green-soft);
    border-top-color: var(--green);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .eyebrow {
    color: var(--green);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .eyebrow.danger {
    color: #b91c1c;
  }

  h1 {
    font-size: clamp(24px, 4vw, 32px);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 8px;
  }

  .lead {
    color: var(--muted);
    margin-bottom: 18px;
    font-size: 14px;
    line-height: 1.5;
  }

  .bar {
    height: 6px;
    border-radius: 999px;
    background: #eef6f0;
    overflow: hidden;
    margin-bottom: 10px;
  }

  .bar span {
    display: block;
    height: 100%;
    width: 8%;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--green), #4ade80);
    transition: width 0.4s ease;
  }

  .keybox {
    background: #f4faf6;
    border: 1px dashed color-mix(in srgb, var(--green) 35%, var(--line));
    border-radius: 16px;
    padding: 14px;
    margin-bottom: 16px;
    text-align: left;
  }

  .keybox span {
    display: block;
    font-size: 11px;
    font-weight: 800;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 6px;
  }

  .keyrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }

  .keybox code {
    flex: 1 1 220px;
    display: block;
    font-size: 18px;
    font-weight: 800;
    letter-spacing: 0.04em;
    cursor: pointer;
  }

  .keybox button {
    border: 0;
    background: var(--green);
    color: #fff;
    font: inherit;
    font-size: 13px;
    font-weight: 800;
    padding: 10px 14px;
    border-radius: 10px;
    cursor: pointer;
    white-space: nowrap;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
  }

  .primary,
  .ghost {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 16px;
    border-radius: 14px;
    font-weight: 800;
    font-size: 14px;
  }

  .primary {
    background: var(--green);
    color: #fff;
  }

  .ghost {
    background: #fff;
    border: 1px solid var(--line);
  }

  .hint {
    margin-top: 14px;
    font-size: 12px;
    color: var(--muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .spinner {
      animation: none;
      border-top-color: var(--green);
    }
  }
</style>
