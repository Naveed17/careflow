---
import Layout from '../layouts/Layout.astro';
import { DOWNLOAD_URL, licenseApiBase } from '../data/pricing';

const apiBase = licenseApiBase();
---

<Layout
  title="Payment success — CareFlow License"
  description="Your CareFlow lifetime license key after Paddle checkout."
  canonicalPath="/success"
>
  <section class="wrap">
    <div class="card" id="result">
      <p class="eyebrow">Lifetime license</p>
      <h1>Thanks for your purchase</h1>
      <p class="lead" id="status">Confirming payment and generating your license key…</p>

      <form id="recover" class="recover" hidden>
        <p>No payment id was found in the URL. Paste the Paddle transaction id from your receipt (starts with txn_).</p>
        <input id="txn-input" name="txn" placeholder="txn_..." autocomplete="off" />
        <button type="submit">Get my license key</button>
      </form>

      <div class="keybox" id="keybox" hidden>
        <span>Your license key</span>
        <div class="keyrow">
          <code id="key" tabindex="0" title="Click to copy"></code>
          <button type="button" id="copy">Copy key</button>
        </div>
      </div>

      <div class="actions">
        <a class="primary" href={DOWNLOAD_URL}>Download CareFlow Setup.exe</a>
        <a class="ghost" href="/#packages">Back to packages</a>
      </div>
      <p class="hint">
        Copy this key and activate it in CareFlow after install. Keep it safe — it is not emailed.
      </p>
    </div>
  </section>

  <script define:vars={{ apiBase }}>
    const params = new URLSearchParams(window.location.search);
    const storedTxn = (() => {
      try {
        return sessionStorage.getItem('careflow_ptxn') || '';
      } catch {
        return '';
      }
    })();
    let sessionId = params.get('session_id') || params.get('_ptxn') || params.get('txn') || storedTxn;
    const mockKey = params.get('key');
    const status = document.getElementById('status');
    const keybox = document.getElementById('keybox');
    const keyEl = document.getElementById('key');
    const copy = document.getElementById('copy');

    const recover = document.getElementById('recover');
    const txnInput = document.getElementById('txn-input');

    function showKey(key) {
      if (!key) return;
      keybox.hidden = false;
      if (recover) recover.hidden = true;
      keyEl.textContent = key;
      status.textContent = 'Your lifetime license is ready. Download the app and activate with this key.';
      try {
        sessionStorage.removeItem('careflow_ptxn');
      } catch {
        /* ignore */
      }
    }

    function copyKey() {
      const value = keyEl.textContent || '';
      if (!value) return;
      navigator.clipboard.writeText(value).then(
        () => {
          copy.textContent = 'Copied';
          setTimeout(() => {
            copy.textContent = 'Copy key';
          }, 1800);
        },
        () => {
          const range = document.createRange();
          range.selectNodeContents(keyEl);
          const sel = window.getSelection();
          sel?.removeAllRanges();
          sel?.addRange(range);
          copy.textContent = 'Select and copy';
        },
      );
    }

    copy?.addEventListener('click', copyKey);
    keyEl?.addEventListener('click', copyKey);

    async function loadLicense(id) {
      const maxAttempts = 10;
      for (let attempt = 1; attempt <= maxAttempts; attempt++) {
        try {
          const res = await fetch(apiBase + '/api/billing/session/' + encodeURIComponent(id));
          const json = await res.json();
          if (json?.data?.paid && json.data.licenseKey) {
            showKey(json.data.licenseKey);
            return true;
          }
        } catch {
          if (attempt === maxAttempts) {
            status.textContent =
              'Could not reach the license server to fetch your key. If this page is https://, the API must also be https (not localhost). Try refresh.';
            return false;
          }
        }
        status.textContent =
          'Payment is still processing (' + attempt + '/' + maxAttempts + '). Generating your license key…';
        await new Promise((r) => setTimeout(r, 2000));
      }
      status.textContent =
        'Payment received, but the license key is not ready yet. Refresh this page, or paste your txn_ id below.';
      if (recover) recover.hidden = false;
      return false;
    }

    recover?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const id = String(txnInput?.value || '').trim();
      if (!id.startsWith('txn_')) {
        status.textContent = 'Transaction id should start with txn_';
        return;
      }
      status.textContent = 'Looking up your license key…';
      await loadLicense(id);
    });

    (async () => {
      if (mockKey) {
        showKey(mockKey);
        return;
      }
      if (!sessionId) {
        status.textContent = 'Missing checkout session. Paste your Paddle transaction id (txn_...) to get the key.';
        if (recover) recover.hidden = false;
        return;
      }
      await loadLicense(sessionId);
    })();
  </script>
</Layout>

<style>
  .wrap {
    min-height: 70vh;
    display: grid;
    place-items: center;
    padding: 120px 20px 60px;
  }

  .card {
    width: min(560px, 100%);
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 28px;
    padding: 32px 28px;
    box-shadow: 0 20px 50px rgba(15, 20, 16, 0.08);
  }

  .eyebrow {
    color: var(--green);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  h1 {
    font-size: clamp(28px, 4vw, 36px);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 10px;
  }

  .lead {
    color: var(--muted);
    margin-bottom: 20px;
  }

  .recover {
    margin-bottom: 18px;
  }

  .recover p {
    font-size: 13px;
    color: var(--muted);
    margin-bottom: 8px;
  }

  .recover input {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid var(--line);
    border-radius: 12px;
    font: inherit;
    margin-bottom: 8px;
  }

  .recover button {
    border: 0;
    background: var(--green);
    color: #fff;
    font: inherit;
    font-size: 13px;
    font-weight: 800;
    padding: 10px 14px;
    border-radius: 10px;
    cursor: pointer;
  }

  .keybox {
    background: #f4faf6;
    border: 1px dashed color-mix(in srgb, var(--green) 35%, var(--line));
    border-radius: 16px;
    padding: 14px;
    margin-bottom: 18px;
  }

  .keybox span {
    display: block;
    font-size: 11px;
    font-weight: 800;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 6px;
  }

  .keyrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }

  .keybox code {
    flex: 1 1 220px;
    display: block;
    font-size: 18px;
    font-weight: 800;
    letter-spacing: 0.04em;
    cursor: pointer;
  }

  .keybox button {
    border: 0;
    background: var(--green);
    color: #fff;
    font: inherit;
    font-size: 13px;
    font-weight: 800;
    padding: 10px 14px;
    border-radius: 10px;
    cursor: pointer;
    white-space: nowrap;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .primary,
  .ghost {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 16px;
    border-radius: 14px;
    font-weight: 800;
    font-size: 14px;
  }

  .primary {
    background: var(--green);
    color: #fff;
  }

  .ghost {
    background: #fff;
    border: 1px solid var(--line);
  }

  .hint {
    margin-top: 16px;
    font-size: 12px;
    color: var(--muted);
  }
</style>
