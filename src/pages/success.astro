---
import Layout from '../layouts/Layout.astro';
import { DOWNLOAD_URL, licenseApiBase } from '../data/pricing';

const apiBase = licenseApiBase();
---

<Layout
  title="Payment success — CareFlow License"
  description="Your CareFlow lifetime license key after Paddle checkout."
  canonicalPath="/success"
>
  <section class="wrap">
    <div class="card" id="result" hidden>
      <p class="eyebrow">Lifetime license</p>
      <h1>Thanks for your purchase</h1>
      <p class="lead" id="status">Confirming payment and generating your license key…</p>

      <div class="keybox" id="keybox" hidden>
        <span>Your license key</span>
        <div class="keyrow">
          <code id="key" tabindex="0" title="Click to copy"></code>
          <button type="button" id="copy">Copy key</button>
        </div>
      </div>

      <div class="actions">
        <a class="primary" href={DOWNLOAD_URL}>Download CareFlow Setup.exe</a>
        <a class="ghost" href="/#packages">Back to packages</a>
      </div>
      <p class="hint">
        Copy this key and activate it in CareFlow after install. Keep it safe — it is not emailed.
      </p>
    </div>

    <div class="card error" id="not-found" hidden>
      <p class="eyebrow danger">404</p>
      <h1>Transaction ID not found</h1>
      <p class="lead" id="not-found-msg">
        This page only opens after a completed Paddle checkout with a valid transaction id in the URL.
      </p>
      <div class="actions">
        <a class="primary" href="/#packages">Back to packages</a>
        <a class="ghost" href="/">Go home</a>
      </div>
    </div>
  </section>

  <script define:vars={{ apiBase }}>
    const params = new URLSearchParams(window.location.search);
    const rawTxn = String(params.get('_ptxn') || '').trim();
    const txnOk = /^txn_[a-z0-9]+$/i.test(rawTxn);

    const result = document.getElementById('result');
    const notFound = document.getElementById('not-found');
    const notFoundMsg = document.getElementById('not-found-msg');
    const status = document.getElementById('status');
    const keybox = document.getElementById('keybox');
    const keyEl = document.getElementById('key');
    const copy = document.getElementById('copy');

    function showNotFound(message) {
      if (result) result.hidden = true;
      if (notFound) notFound.hidden = false;
      if (notFoundMsg && message) notFoundMsg.textContent = message;
      document.title = 'Transaction ID not found — CareFlow';
    }

    function showSuccessUi() {
      if (notFound) notFound.hidden = true;
      if (result) result.hidden = false;
    }

    function showKey(key) {
      if (!key) return;
      showSuccessUi();
      keybox.hidden = false;
      keyEl.textContent = key;
      status.textContent = 'Your lifetime license is ready. Download the app and activate with this key.';
      try {
        sessionStorage.removeItem('careflow_ptxn');
      } catch {
        /* ignore */
      }
    }

    function copyKey() {
      const value = keyEl.textContent || '';
      if (!value) return;
      navigator.clipboard.writeText(value).then(
        () => {
          copy.textContent = 'Copied';
          setTimeout(() => {
            copy.textContent = 'Copy key';
          }, 1800);
        },
        () => {
          const range = document.createRange();
          range.selectNodeContents(keyEl);
          const sel = window.getSelection();
          sel?.removeAllRanges();
          sel?.addRange(range);
          copy.textContent = 'Select and copy';
        },
      );
    }

    copy?.addEventListener('click', copyKey);
    keyEl?.addEventListener('click', copyKey);

    async function loadLicense(id) {
      showSuccessUi();
      const maxAttempts = 10;
      for (let attempt = 1; attempt <= maxAttempts; attempt++) {
        try {
          const res = await fetch(apiBase + '/api/billing/session/' + encodeURIComponent(id));
          if (res.status === 404) {
            showNotFound('Transaction ID not found. No matching Paddle payment was found for this id.');
            return false;
          }
          const json = await res.json().catch(() => null);
          if (json?.data?.paid && json.data.licenseKey) {
            showKey(json.data.licenseKey);
            return true;
          }
          // Still processing — keep waiting
        } catch {
          if (attempt === maxAttempts) {
            showNotFound('Could not verify this transaction id. Please try again from your Paddle receipt link.');
            return false;
          }
        }
        status.textContent =
          'Payment is still processing (' + attempt + '/' + maxAttempts + '). Generating your license key…';
        await new Promise((r) => setTimeout(r, 2000));
      }
      showNotFound('Transaction ID not found or payment was not completed.');
      return false;
    }

    (async () => {
      if (!rawTxn) {
        showNotFound(
          'No transaction id in the URL. Open this page only after checkout, e.g. /success?_ptxn=txn_…',
        );
        return;
      }
      if (!txnOk) {
        showNotFound('Invalid transaction id. It must look like txn_01…');
        return;
      }
      try {
        sessionStorage.setItem('careflow_ptxn', rawTxn);
      } catch {
        /* ignore */
      }
      await loadLicense(rawTxn);
    })();
  </script>
</Layout>

<style>
  .wrap {
    min-height: 70vh;
    display: grid;
    place-items: center;
    padding: 120px 20px 60px;
  }

  .card {
    width: min(560px, 100%);
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 28px;
    padding: 32px 28px;
    box-shadow: 0 20px 50px rgba(15, 20, 16, 0.08);
  }

  .eyebrow {
    color: var(--green);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .eyebrow.danger {
    color: #b91c1c;
  }

  h1 {
    font-size: clamp(28px, 4vw, 36px);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 10px;
  }

  .lead {
    color: var(--muted);
    margin-bottom: 20px;
  }

  .keybox {
    background: #f4faf6;
    border: 1px dashed color-mix(in srgb, var(--green) 35%, var(--line));
    border-radius: 16px;
    padding: 14px;
    margin-bottom: 18px;
  }

  .keybox span {
    display: block;
    font-size: 11px;
    font-weight: 800;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 6px;
  }

  .keyrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }

  .keybox code {
    flex: 1 1 220px;
    display: block;
    font-size: 18px;
    font-weight: 800;
    letter-spacing: 0.04em;
    cursor: pointer;
  }

  .keybox button {
    border: 0;
    background: var(--green);
    color: #fff;
    font: inherit;
    font-size: 13px;
    font-weight: 800;
    padding: 10px 14px;
    border-radius: 10px;
    cursor: pointer;
    white-space: nowrap;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .primary,
  .ghost {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 16px;
    border-radius: 14px;
    font-weight: 800;
    font-size: 14px;
  }

  .primary {
    background: var(--green);
    color: #fff;
  }

  .ghost {
    background: #fff;
    border: 1px solid var(--line);
  }

  .hint {
    margin-top: 16px;
    font-size: 12px;
    color: var(--muted);
  }
</style>
