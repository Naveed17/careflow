---
import Icon from './Icon.astro';

const modules = [
  { title: 'Dashboard', desc: 'Role homes for Admin, Doctor, Reception & Lab with live queues.', icon: 'layout' as const },
  { title: 'Patients', desc: 'MR numbers, allergies, documents and full visit history in one profile.', icon: 'users' as const },
  { title: 'Appointments', desc: 'Calendar & agenda, check-in / complete, and doctor-day planning.', icon: 'calendar' as const },
  { title: 'OPD Tokens', desc: 'Issue walk-in tokens, live waiting queue, print slips and complete visits.', icon: 'list' as const },
  { title: 'Prescription', desc: 'Letterhead Rx with free-type editor, lists, save + PDF print.', icon: 'file' as const },
  { title: 'Billing', desc: 'Invoices, payments, voids and pending billing for the front desk.', icon: 'receipt' as const },
  { title: 'Lab', desc: 'Orders linked to visits with technician workflow and results.', icon: 'flask' as const },
];
---

<section class="section modules" id="modules">
  <div class="head" data-reveal>
    <h2>Clinic modules for every desk</h2>
    <p>Licensed Windows workspace — unlock only what your clinic needs.</p>
  </div>
  <div class="grid">
    {
      modules.map((m, i) => (
        <article class:list={['card', i === 0 && 'accent']} data-reveal data-delay={String((i % 4) * 50)}>
          <span class="ico">
            <Icon name={m.icon} size={18} />
          </span>
          <h3>{m.title}</h3>
          <p>{m.desc}</p>
        </article>
      ))
    }
  </div>
</section>

<style>
  .modules {
    padding-top: 40px;
    padding-bottom: 56px;
  }

  .head {
    text-align: center;
    max-width: 480px;
    margin: 0 auto 32px;
  }

  .head h2 {
    margin: 0 0 8px;
    font-size: clamp(28px, 3.4vw, 38px);
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .head p {
    margin: 0;
    color: var(--muted);
    font-size: 15px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
  }

  .card {
    min-height: 100%;
    background: #fff;
    border: 1px solid rgba(15, 42, 26, 0.07);
    border-radius: 20px;
    padding: 20px;
    box-shadow: 0 10px 28px rgba(15, 42, 26, 0.04);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .card.accent {
    background: linear-gradient(160deg, #ecfdf5, #fff);
    border-color: transparent;
  }

  .ico {
    width: 40px;
    height: 40px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    background: var(--green-soft);
    color: var(--green-deep);
  }

  .card.accent .ico {
    background: #fff;
    box-shadow: 0 4px 12px rgba(22, 163, 74, 0.1);
  }

  h3 {
    margin: 0;
    font-size: 15px;
    font-weight: 800;
  }

  p {
    margin: 0;
    font-size: 13px;
    color: var(--muted);
    line-height: 1.5;
  }

  @media (max-width: 980px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
