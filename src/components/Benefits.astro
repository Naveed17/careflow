---
import Icon from './Icon.astro';

const points = [
  {
    title: 'Complete All-in-One Clinic Suite',
    desc: 'Doctor OPD queue, digital prescription writing (EMR), reception token counter, billing, lab technician portal, and real-time team chat — all in a single software.',
  },
  {
    title: 'Works 100% Offline & Reliable',
    desc: 'Local SQLite database ensures lightning-fast performance on your clinic PCs with zero internet dependency. Never lose access to patient records or OPD queues.',
  },
  {
    title: 'LAN Multi-PC & Multi-Desk Connection',
    desc: 'Connect doctor desks, reception counters, and lab rooms seamlessly over local network (LAN) or sync live across clinic branches with optional cloud database.',
  },
  {
    title: 'Instant Setup & Seamless Workflows',
    desc: 'Activate instantly with your license key. Role-based dashboards for Doctors, Receptionists, and Lab Techs make daily clinic operations effortless.',
  },
];
---

<section class="section why" id="benefits">
  <div class="layout">
    <div class="collage" data-reveal aria-hidden="true">
      <div class="soft" data-speed="-0.25"></div>
      <div class="circle main" data-speed="-0.15">
        <img src="/brand/logo.png" alt="" width="72" height="72" />
      </div>
      <div class="circle a" data-speed="0.45"><Icon name="stethoscope" size={26} /></div>
      <div class="circle b" data-speed="-0.55"><Icon name="file" size={22} /></div>
      <div class="circle c" data-speed="0.5"><Icon name="clipboard" size={20} /></div>
    </div>

    <div class="copy" data-reveal data-delay="80">
      <h2>Why Choose CareFlow?</h2>
      <p class="intro">
        Fast, reliable clinic management software designed to streamline consultations, OPD reception, lab workflows, and billing with complete peace of mind.
      </p>
      <ul>
        {
          points.map((p) => (
            <li>
              <span class="ico">
                <Icon name="check" size={16} />
              </span>
              <div>
                <strong>{p.title}</strong>
                <span>{p.desc}</span>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .why {
    padding-top: 56px;
    padding-bottom: 56px;
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: 48px;
    align-items: center;
  }

  .collage {
    position: relative;
    width: 100%;
    max-width: 420px;
    margin-inline: auto;
    aspect-ratio: 1;
    overflow: visible;
  }

  .soft {
    position: absolute;
    inset: 10%;
    border-radius: 48% 52% 45% 55% / 55% 45% 55% 45%;
    background: linear-gradient(150deg, #bbf7d0, #ecfdf5);
  }

  .circle {
    position: absolute;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 14px 32px rgba(15, 42, 26, 0.1);
    display: grid;
    place-items: center;
    color: var(--green-deep);
  }

  .main {
    width: 48%;
    aspect-ratio: 1;
    left: 26%;
    top: 26%;
    z-index: 2;
  }

  .main img {
    width: 40%;
    height: 40%;
    border-radius: 14px;
  }

  .a,
  .b,
  .c {
    color: var(--green);
  }

  .a {
    width: 72px;
    height: 72px;
    left: 6%;
    top: 14%;
    background: linear-gradient(145deg, #ecfdf5, #fff);
    z-index: 3;
  }

  .b {
    width: 60px;
    height: 60px;
    right: 10%;
    top: 22%;
    background: #fff;
    z-index: 3;
  }

  .c {
    width: 56px;
    height: 56px;
    left: 16%;
    bottom: 14%;
    background: #fff;
    z-index: 3;
  }

  .copy h2 {
    margin: 0 0 12px;
    font-size: clamp(28px, 3.4vw, 38px);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  .intro {
    margin: 0 0 24px;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.6;
    max-width: 44ch;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
  }

  li {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    gap: 14px;
    align-items: start;
  }

  .ico {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #0f2a1a;
    color: #fff;
    display: grid;
    place-items: center;
  }

  li strong {
    display: block;
    font-size: 15px;
    font-weight: 800;
    margin-bottom: 4px;
  }

  li span:last-child {
    font-size: 14px;
    color: var(--muted);
    line-height: 1.55;
  }

  @media (max-width: 860px) {
    .layout {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .collage {
      max-width: 320px;
    }

    .intro {
      max-width: none;
    }
  }
</style>
