---
import {
  ADDON_FEATURES,
  BASE_FEATURES,
  BASE_PRICE_USD,
  DOWNLOAD_URL,
  FULL_PRICE_USD,
  FUTURE_PREMIUM,
  MONTHLY_BASE_PRICE_USD,
  MONTHLY_FULL_PRICE_USD,
  ONLINE_DB_ANNUAL_USD,
  WHATSAPP_AI_MONTHLY_USD,
  ONLINE_DB_PERIOD_YEARS,
  WHATSAPP_AI_PERIOD_MONTHS,
  licenseApiBase,
} from '../data/pricing';

const apiBase = licenseApiBase();
---

<section class="cf-pkg section" id="packages">
  <div class="cf-pkg__head" data-reveal>
    <h2>Build your CareFlow package</h2>
    <p>
      Lifetime starter is <strong>${BASE_PRICE_USD}</strong> (full <strong>${FULL_PRICE_USD}</strong>).
      Monthly starter is <strong>${MONTHLY_BASE_PRICE_USD}/mo</strong> (full software
      <strong>${MONTHLY_FULL_PRICE_USD}/mo</strong>). WhatsApp, AI and online database keep their
      current fees — they are not converted to monthly license add-ons.
    </p>
  </div>

  <div class="cf-pkg__panel" data-reveal data-delay="60">
    <div class="cf-pkg__builder">
      <div class="cf-pkg__plans" role="tablist" aria-label="Billing interval">
        <button type="button" class="is-on" id="pkg-plan-lifetime" data-plan="lifetime">Lifetime</button>
        <button type="button" id="pkg-plan-monthly" data-plan="monthly">Monthly</button>
      </div>

      <div class="cf-pkg__base">
        <div class="cf-pkg__icon cf-pkg__icon--ok" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
            <path d="M5 12l5 5L20 7" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </div>
        <div class="cf-pkg__meta">
          <strong id="pkg-core-title">Core · Doctor + Reception</strong>
          <small>{BASE_FEATURES.map((f) => f.label).join(' · ')}</small>
        </div>
        <span class="cf-pkg__price" id="pkg-core-price">${BASE_PRICE_USD}</span>
      </div>

      <div class="cf-pkg__divider">
        <span>Add modules</span>
        <button type="button" id="pkg-full">Select full pack</button>
      </div>

      <div class="cf-pkg__list" id="pkg-addons">
        {
          ADDON_FEATURES.map((f) => (
            <label class="cf-pkg__item">
              <input
                type="checkbox"
                data-addon={f.key}
                data-price={f.price}
                data-monthly-price={'monthlyPrice' in f ? f.monthlyPrice : ''}
              />
              <span class="cf-pkg__check" aria-hidden="true"></span>
              <span class="cf-pkg__meta">
                <strong>{f.label}</strong>
                <small>{f.hint}</small>
              </span>
              <span class="cf-pkg__price">
                <span data-addon-price>+${f.price}</span>
                { 'hosted' in f && f.hosted ? <small>+${WHATSAPP_AI_MONTHLY_USD}/mo</small> : null}
              </span>
            </label>
          ))
        }
      </div>

      <div class="cf-pkg__divider">
        <span>Considering for premium</span>
      </div>
      <div class="cf-pkg__list">
        {
          FUTURE_PREMIUM.map((f) => (
            <div class="cf-pkg__item cf-pkg__item--soon">
              <span class="cf-pkg__check cf-pkg__check--soon" aria-hidden="true"></span>
              <span class="cf-pkg__meta">
                <strong>{f.label}</strong>
                <small>{f.hint}</small>
              </span>
              <span class="cf-pkg__price"><small>Later</small></span>
            </div>
          ))
        }
      </div>

      <div class="cf-pkg__divider">
        <span>Hosted services</span>
      </div>

      <label class="cf-pkg__item">
        <input type="checkbox" id="pkg-online-db" />
        <span class="cf-pkg__check" aria-hidden="true"></span>
        <span class="cf-pkg__meta">
          <strong>Online database</strong>
          <small>Cloud Postgres for your clinic — billed ${ONLINE_DB_ANNUAL_USD}/year, then auto-off. Off keeps local SQLite.</small>
        </span>
        <span class="cf-pkg__price">+${ONLINE_DB_ANNUAL_USD}/yr</span>
      </label>
    </div>

    <aside class="cf-pkg__checkout">
      <p class="cf-pkg__label">Checkout</p>
      <div class="cf-pkg__total">
        <span id="pkg-total-label">Lifetime</span>
        <strong>$<span id="pkg-price">{BASE_PRICE_USD}</span></strong>
      </div>
      <p class="cf-pkg__once" id="pkg-once">USD · one-time Paddle checkout</p>
      <ul class="cf-pkg__recurring" id="pkg-recurring">
        <li id="pkg-recurring-db" hidden>
          <span>Online DB</span>
          <strong>${ONLINE_DB_ANNUAL_USD}/yr</strong>
        </li>
        <li id="pkg-recurring-hosted" hidden>
          <span>WhatsApp + AI</span>
          <strong>${WHATSAPP_AI_MONTHLY_USD}/mo</strong>
        </li>
      </ul>

      <form id="pkg-form" class="cf-pkg__form" novalidate>
        <input name="userName" required minlength="2" placeholder="Full name" autocomplete="name" />
        <input name="email" type="email" required placeholder="Email" autocomplete="email" />
        <input name="whatsappNumber" required minlength="10" placeholder="WhatsApp" autocomplete="tel" />
        <p class="cf-pkg__err" id="pkg-err" hidden></p>
        <button type="submit" class="cf-pkg__buy" id="pkg-buy">
          <span class="cf-spin cf-spin--btn" id="pkg-buy-spin" hidden></span>
          <span id="pkg-buy-text">Purchase &amp; get license — ${BASE_PRICE_USD}</span>
        </button>
      </form>

      <a class="cf-pkg__dl" href={DOWNLOAD_URL}>Download CareFlow-Setup.exe</a>
      <p class="cf-pkg__fine">
        Paddle charges the license today. Monthly software renews each month. Online DB and WhatsApp/AI hosted fees start from the day they are enabled, then auto-off.
        <a href="/renew">Renew hosted services</a>
      </p>
    </aside>
  </div>
</section>

<script define:vars={{
  apiBase,
  BASE_PRICE_USD,
  FULL_PRICE_USD,
  MONTHLY_BASE_PRICE_USD,
  MONTHLY_FULL_PRICE_USD,
  ONLINE_DB_ANNUAL_USD,
  WHATSAPP_AI_MONTHLY_USD,
}}>
  const priceEl = document.getElementById('pkg-price');
  const form = document.getElementById('pkg-form');
  const err = document.getElementById('pkg-err');
  const buy = document.getElementById('pkg-buy');
  const buyText = document.getElementById('pkg-buy-text');
  const buySpin = document.getElementById('pkg-buy-spin');
  const fullBtn = document.getElementById('pkg-full');
  const onlineDbEl = document.getElementById('pkg-online-db');
  const recDb = document.getElementById('pkg-recurring-db');
  const recHosted = document.getElementById('pkg-recurring-hosted');
  const onceEl = document.getElementById('pkg-once');
  const corePrice = document.getElementById('pkg-core-price');
  const coreTitle = document.getElementById('pkg-core-title');
  const totalLabel = document.getElementById('pkg-total-label');
  const lifetimeBtn = document.getElementById('pkg-plan-lifetime');
  const monthlyBtn = document.getElementById('pkg-plan-monthly');
  const boxes = () => Array.from(document.querySelectorAll('[data-addon]'));
  let billingInterval = 'lifetime';

  function isHostedAddon(el) {
    return el.dataset.addon === 'whatsapp' || el.dataset.addon === 'ai';
  }

  function hostedOn() {
    return boxes().some((el) => isHostedAddon(el) && el.checked);
  }

  function addonUnitPrice(el) {
    if (billingInterval === 'monthly' && el.dataset.monthlyPrice) {
      return Number(el.dataset.monthlyPrice || 0);
    }
    return Number(el.dataset.price || 0);
  }

  function syncAddonLabels() {
    boxes().forEach((el) => {
      const label = el.parentElement?.querySelector('[data-addon-price]');
      if (!label) return;
      const price = addonUnitPrice(el);
      const monthlySoft = billingInterval === 'monthly' && el.dataset.monthlyPrice;
      label.textContent = '+$' + price + (monthlySoft ? '/mo' : '');
    });
    if (corePrice) {
      corePrice.textContent =
        billingInterval === 'monthly' ? '$' + MONTHLY_BASE_PRICE_USD + '/mo' : '$' + BASE_PRICE_USD;
    }
    if (coreTitle) {
      coreTitle.textContent =
        billingInterval === 'monthly' ? 'Monthly starter · Doctor + Reception' : 'Core · Doctor + Reception';
    }
    if (onceEl) {
      onceEl.textContent =
        billingInterval === 'monthly'
          ? 'USD · monthly software + current WhatsApp / AI / Online DB fees'
          : 'USD · one-time Paddle checkout';
    }
    if (totalLabel) totalLabel.textContent = billingInterval === 'monthly' ? 'Due today' : 'Lifetime';
    lifetimeBtn?.classList.toggle('is-on', billingInterval === 'lifetime');
    monthlyBtn?.classList.toggle('is-on', billingInterval === 'monthly');
  }

  function formatCost(total, yearly, hostedMo, interval, setup) {
    const parts = [interval === 'monthly' ? '$' + total + '/mo' : '$' + total];
    if (setup) parts.push('$' + setup + ' setup');
    if (yearly) parts.push('$' + yearly + '/yr');
    if (hostedMo) parts.push('$' + hostedMo + '/mo hosted');
    return parts.join(' + ');
  }

  function calc() {
    syncAddonLabels();
    let software = 0;
    let setup = 0;
    let allSoftware = true;
    let allLifetime = true;
    boxes().forEach((el) => {
      const hosted = isHostedAddon(el);
      if (billingInterval === 'monthly') {
        if (hosted) {
          if (el.checked) setup += Number(el.dataset.price || 0);
          return;
        }
        if (!el.checked) allSoftware = false;
        if (el.checked) software += addonUnitPrice(el);
        return;
      }
      if (!el.checked) allLifetime = false;
      if (el.checked) software += addonUnitPrice(el);
    });
    const base = billingInterval === 'monthly' ? MONTHLY_BASE_PRICE_USD : BASE_PRICE_USD;
    const full = billingInterval === 'monthly' ? MONTHLY_FULL_PRICE_USD : FULL_PRICE_USD;
    const recurring = billingInterval === 'monthly'
      ? (allSoftware ? full : base + software)
      : (allLifetime ? full : base + software);
    const dueToday = recurring + setup;
    const yearly = onlineDbEl && onlineDbEl.checked ? ONLINE_DB_ANNUAL_USD : 0;
    const hostedMo = hostedOn() ? WHATSAPP_AI_MONTHLY_USD : 0;
    if (priceEl) priceEl.textContent = String(dueToday);
    if (recDb) recDb.hidden = !yearly;
    if (recHosted) recHosted.hidden = !hostedMo;
    if (buyText && !buy?.disabled) {
      buyText.innerHTML =
        'Purchase &amp; get license — ' + formatCost(recurring, yearly, hostedMo, billingInterval, setup);
    }
    return {
      total: dueToday,
      yearly,
      monthly: hostedMo,
      onlineDatabase: Boolean(onlineDbEl && onlineDbEl.checked),
      billingInterval,
    };
  }

  function setBusy(on, message) {
    if (buy) {
      buy.disabled = on;
      buy.classList.toggle('is-busy', on);
      buy.setAttribute('aria-busy', on ? 'true' : 'false');
    }
    if (buySpin) buySpin.hidden = !on;
    if (on) {
      if (buyText) buyText.textContent = message || 'Please wait…';
    } else {
      calc();
    }
  }

  function preferLocalHttp(url) {
    if (typeof window.careflowPreferLocalHttp === 'function') {
      return window.careflowPreferLocalHttp(url);
    }
    const here = location.hostname.toLowerCase();
    const local = here === 'localhost' || here === '127.0.0.1';
    if (!local || !url) return url;
    try {
      const u = new URL(url, location.origin);
      const host = u.hostname.toLowerCase();
      if ((host === 'localhost' || host === '127.0.0.1') && u.protocol === 'https:') {
        u.protocol = 'http:';
        return u.toString();
      }
    } catch {
      /* keep original */
    }
    return url;
  }

  function setPlan(next) {
    billingInterval = next === 'monthly' ? 'monthly' : 'lifetime';
    calc();
  }

  boxes().forEach((el) => el.addEventListener('change', calc));
  onlineDbEl?.addEventListener('change', calc);
  fullBtn?.addEventListener('click', () => {
    boxes().forEach((el) => {
      el.checked = true;
    });
    calc();
  });
  lifetimeBtn?.addEventListener('click', () => setPlan('lifetime'));
  monthlyBtn?.addEventListener('click', () => setPlan('monthly'));
  calc();

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form) return;
    err.hidden = true;
    const fd = new FormData(form);
    const userName = String(fd.get('userName') || '').trim();
    const email = String(fd.get('email') || '').trim();
    const whatsappNumber = String(fd.get('whatsappNumber') || '').trim();
    if (userName.length < 2 || !email.includes('@') || whatsappNumber.length < 10) {
      err.textContent = 'Please enter a valid name, email and WhatsApp number.';
      err.hidden = false;
      return;
    }

    const addons = {};
    boxes().forEach((el) => {
      addons[el.dataset.addon] = el.checked;
    });
    const { onlineDatabase } = calc();

    setBusy(true, 'Redirecting to secure checkout...');
    try {
      const res = await fetch(apiBase + '/api/billing/checkout', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          userName,
          email,
          whatsappNumber,
          addons,
          onlineDatabase,
          billingInterval,
        }),
      });
      const json = await res.json();
      if (!res.ok) throw new Error(json?.message || 'Checkout failed');
      const url = json?.data?.url;
      if (!url) throw new Error('No checkout URL returned');
      window.location.href = preferLocalHttp(url);
    } catch (ex) {
      err.textContent = (ex && ex.message) || 'Could not start checkout. Is the license server running?';
      err.hidden = false;
      setBusy(false);
    }
  });
</script>
