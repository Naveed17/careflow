---
const token = String(import.meta.env.PUBLIC_PADDLE_CLIENT_TOKEN || '').trim();
const envFromFile = String(import.meta.env.PUBLIC_PADDLE_ENV || '').trim().toLowerCase();
const env = envFromFile === 'production' || envFromFile === 'live'
  ? 'production'
  : envFromFile === 'sandbox' || token.startsWith('test_')
    ? 'sandbox'
    : 'production';

const origin = Astro.url.origin.replace(/\/+$/, '');
const successBase = `${origin}/success`;
const isSuccessPage = Astro.url.pathname.replace(/\/+$/, '') === '/success';
const enabled = Boolean(token) && !isSuccessPage;
---

{enabled && (
  <>
    <script is:inline defer src="https://cdn.paddle.com/paddle/v2/paddle.js"></script>
    <script is:inline define:vars={{ token, env, successBase }}>
      (function bootPaddle() {
        var Paddle = window.Paddle;
        if (!Paddle) {
          setTimeout(bootPaddle, 40);
          return;
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', bootPaddle);
          return;
        }

        var host = (location.hostname || '').toLowerCase();
        var localHost = host === 'localhost' || host === '127.0.0.1';
        var localSandbox = env === 'sandbox' && localHost;

        // Paddle dashboard forces https on the default payment link.
        // Local Astro is http://localhost:4321 — bounce only on localhost sandbox.
        if (localSandbox && location.protocol === 'https:') {
          location.replace(
            'http://' + location.host + location.pathname + location.search + location.hash,
          );
          return;
        }

        function preferLocalHttp(url) {
          if (!localSandbox || !url) return url;
          try {
            var u = new URL(url, location.origin);
            var h = u.hostname.toLowerCase();
            if ((h === 'localhost' || h === '127.0.0.1') && u.protocol === 'https:') {
              u.protocol = 'http:';
              return u.toString();
            }
          } catch (e) {}
          return url;
        }

        var txn = new URLSearchParams(window.location.search).get('_ptxn') || '';
        if (txn) {
          try {
            sessionStorage.setItem('careflow_ptxn', txn);
          } catch (e) {}
        }

        function successWithTxn(id) {
          var base = successBase;
          if (!id) return base;
          return base + (base.indexOf('?') >= 0 ? '&' : '?') + '_ptxn=' + encodeURIComponent(id);
        }

        var checkoutSettings = {
          displayMode: 'overlay',
          theme: 'light',
        };
        // Do not give Paddle a successUrl on local HTTP — it upgrades it to https://localhost
        // and the browser then fails SSL. JS eventCallback redirects to http:// instead.
        if (!localSandbox) {
          checkoutSettings.successUrl = successWithTxn(txn);
        }

        if (env === 'sandbox') {
          Paddle.Environment.set('sandbox');
        }
        Paddle.Initialize({
          token: token,
          checkout: {
            settings: checkoutSettings,
          },
          eventCallback: function (event) {
            if (!event || event.name !== 'checkout.completed') return;
            var id = (event.data && event.data.transaction_id) || txn;
            if (!id) return;
            try {
              sessionStorage.setItem('careflow_ptxn', id);
            } catch (e) {}
            window.location.href = preferLocalHttp(successWithTxn(id));
          },
        });
        window.careflowPreferLocalHttp = preferLocalHttp;
      })();
    </script>
  </>
)}
