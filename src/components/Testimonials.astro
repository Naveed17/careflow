---
import Icon from './Icon.astro';

const quotes = [
  {
    name: 'Dr. Sara Khan',
    role: 'Family Clinic, Lahore',
    text: 'Queue and prescriptions finally live in one place. Reception stopped shouting across the hall — CareFlow just works offline.',
  },
  {
    name: 'Ahmed Hassan',
    role: 'Clinic Admin, Karachi',
    text: 'We started with Doctor + Reception, then unlocked lab later. Lifetime key, no monthly surprise — exactly what we needed.',
  },
  {
    name: 'Fatima Noor',
    role: 'Front Desk Lead',
    text: 'Tokens print clean, doctors see the next patient instantly on LAN. Setup was simple and the license activated in minutes.',
  },
];
---

<section class="section testimonials" id="testimonials">
  <div class="head" data-reveal>
    <h2>What our customers are saying</h2>
  </div>

  <div class="slider" data-reveal data-delay="60">
    <button class="nav" type="button" aria-label="Previous" data-t-prev>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M15 18l-6-6 6-6" />
      </svg>
    </button>

    <div class="frame">
      {
        quotes.map((q, i) => (
          <article class:list={['slide', i === 0 && 'is-on']} data-t-slide>
            <div class="photo" aria-hidden="true">
              <span>
                <Icon name="user" size={32} />
              </span>
            </div>
            <div class="quote">
              <p>{q.text}</p>
              <strong>{q.name}</strong>
              <small>{q.role}</small>
            </div>
          </article>
        ))
      }
    </div>

    <button class="nav" type="button" aria-label="Next" data-t-next>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M9 18l6-6-6-6" />
      </svg>
    </button>
  </div>
</section>

<script>
  const slides = Array.from(document.querySelectorAll('[data-t-slide]'));
  let i = 0;

  function show(n) {
    i = (n + slides.length) % slides.length;
    slides.forEach((el, idx) => {
      el.classList.toggle('is-on', idx === i);
    });
  }

  document.querySelector('[data-t-prev]')?.addEventListener('click', () => show(i - 1));
  document.querySelector('[data-t-next]')?.addEventListener('click', () => show(i + 1));
</script>

<style>
  .testimonials {
    padding-top: 40px;
    padding-bottom: 56px;
  }

  .head {
    text-align: center;
    margin-bottom: 28px;
  }

  .head h2 {
    margin: 0;
    font-size: clamp(28px, 3.4vw, 38px);
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .slider {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr) 48px;
    gap: 16px;
    align-items: center;
    max-width: 900px;
    margin: 0 auto;
  }

  .nav {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 0;
    background: var(--green);
    color: #fff;
    display: grid;
    place-items: center;
    cursor: pointer;
  }

  .nav:hover {
    background: var(--green-deep);
  }

  .frame {
    position: relative;
    min-height: 220px;
  }

  .slide {
    display: none;
    grid-template-columns: 160px minmax(0, 1fr);
    gap: 24px;
    align-items: center;
    background: #fff;
    border-radius: 24px;
    padding: 22px;
    border: 1px solid rgba(15, 42, 26, 0.07);
    box-shadow: 0 14px 36px rgba(15, 42, 26, 0.06);
  }

  .slide.is-on {
    display: grid;
  }

  .photo {
    aspect-ratio: 1;
    border-radius: 18px;
    background: linear-gradient(145deg, #86efac, #ecfdf5);
    display: grid;
    place-items: center;
  }

  .photo span {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: #fff;
    display: grid;
    place-items: center;
    color: var(--green-deep);
    box-shadow: 0 12px 28px rgba(22, 163, 74, 0.15);
  }

  .quote p {
    margin: 0 0 14px;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.55;
    color: #0f2a1a;
  }

  .quote strong {
    display: block;
    font-size: 14px;
    font-weight: 800;
  }

  .quote small {
    color: var(--muted);
    font-size: 13px;
    font-weight: 600;
  }

  @media (max-width: 720px) {
    .slider {
      grid-template-columns: 1fr;
      justify-items: center;
    }

    .nav[data-t-prev] {
      display: none;
    }

    .frame {
      width: 100%;
      min-height: 0;
    }

    .slide.is-on {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .photo {
      width: 140px;
      margin: 0 auto;
    }
  }
</style>
