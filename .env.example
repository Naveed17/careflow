# License server origin (no trailing slash)
PUBLIC_LICENSE_API_URL=http://localhost:4000

# Optional production site URL
# SITE=https://careflow.app

# Paddle.js overlay checkout (client-side token — safe to expose)
# Paddle → Developer tools → Authentication → Client-side token
# sandbox tokens start with test_ · live tokens start with live_
PUBLIC_PADDLE_CLIENT_TOKEN=
# sandbox | production  (optional; inferred from token prefix if empty)
PUBLIC_PADDLE_ENV=sandbox
